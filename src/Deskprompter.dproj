    <DCC_UnitSearchPath>Dominio;Aplicacao\Aparencia;Aplicacao\Comandos;Aplicacao\Contratos;Aplicacao\Preferencias;Aplicacao\Rolagem;Infraestrutura\Diagnostico;Infraestrutura\Persistencia\SQLite;Infraestrutura\Tempo;Infraestrutura\Windows;Inicializacao;VCL;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_ExeOutput>..\bin\app</DCC_ExeOutput>
    <DCC_DcuOutput>..\dcu\app\$(Config)</DCC_DcuOutput>
    <DCC_DependencyCheckOutputName>Deskprompter.exe</DCC_DependencyCheckOutputName>
    <Icon_MainIcon>Icones\Deskprompter.ico</Icon_MainIcon>
    <Manifest_File>$(BDS)\bin\default_app.manifest</Manifest_File>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
    <VerInfo_MajorVer>0</VerInfo_MajorVer>
    <VerInfo_MinorVer>1</VerInfo_MinorVer>
    <VerInfo_Release>0</VerInfo_Release>
    <VerInfo_Build>0</VerInfo_Build>
    <VerInfo_Locale>1046</VerInfo_Locale>
    <VerInfo_Keys>CompanyName=;FileDescription=Teleprompter para Windows;FileVersion=$(VerInfo_MajorVer).$(VerInfo_MinorVer).$(VerInfo_Release).$(VerInfo_Build);InternalName=Deskprompter;LegalCopyright=;LegalTrademarks=;OriginalFilename=Deskprompter.exe;ProgramID=com.deskprompter.app;ProductName=Deskprompter;ProductVersion=$(VerInfo_MajorVer).$(VerInfo_MinorVer).$(VerInfo_Release);Comments=</VerInfo_Keys>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_2)'!=''">
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_DebugInformation>2</DCC_DebugInformation>
    <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_SymbolReferenceInfo>2</DCC_SymbolReferenceInfo>
