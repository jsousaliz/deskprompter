    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;Vcl;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>..\src\Dominio;..\src\Aplicacao\Aparencia;..\src\Aplicacao\Comandos;..\src\Aplicacao\Contratos;..\src\Aplicacao\Preferencias;..\src\Aplicacao\Rolagem;..\src\Infraestrutura\Persistencia\SQLite;..\src\VCL;Unitarios\Dominio;Unitarios\Aplicacao;Unitarios\VCL;Integracao\Persistencia;$(BDS)\source\DUnitX;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_ExeOutput>..\bin\tests</DCC_ExeOutput>
        <DCC_DcuOutput>..\dcu\tests\$(Config)</DCC_DcuOutput>
        <SanitizedProjectName>Deskprompter_Testes</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>2</DCC_DebugInformation>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
        <DCC_Optimize>false</DCC_Optimize>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
